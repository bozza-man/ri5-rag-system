# Pi5 RAG System Configuration
# Copy this file to config.env and customize for your setup

# Production Server Configuration
PRODUCTION_HOST=192.168.1.100          # Your Pi5's IP address or hostname
PRODUCTION_USER=pi                      # Username on your Pi5 (usually 'pi')
PRODUCTION_PATH=/home/pi/ri5-rag-system # Path where the system is deployed

# Service Configuration
SERVICE_NAME=pi5-rag-app                # Systemd service name
CHROMA_SERVICE_NAME=pi5-rag-chroma      # ChromaDB service name (if separate)

# Development Configuration
DEV_VENV_PATH=.venv                     # Local virtual environment path
DEV_ENV_FILE=.env                       # Local environment file

# GitHub Configuration (for automatic deployment)
GITHUB_REPO=bozza-man/ri5-rag-system    # GitHub repository
GITHUB_BRANCH=main                      # Branch to deploy from

# SSH Configuration
SSH_KEY_PATH=~/.ssh/id_rsa              # SSH key for production access
SSH_PORT=22                             # SSH port (default: 22)

# Deployment Configuration
AUTO_DEPLOY_TIMER=5                     # Auto-deploy check interval (minutes)
DEPLOY_TIMEOUT=300                      # Deployment timeout (seconds)

# Logging Configuration
LOG_LEVEL=INFO                          # Log level (DEBUG, INFO, WARNING, ERROR)
LOG_FILE=deploy.log                     # Log file path
